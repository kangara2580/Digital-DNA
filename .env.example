# prisma/schema.prisma 기준 상대 경로 → 실제 파일은 prisma/dev.db
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
ADMIN_EMAILS="youngho940701@gmail.com"
CRON_SECRET="set-a-long-random-string-for-production"
NEXT_PUBLIC_DEMO_SELLER_ID="seller-demo"
SEED_SELLER_ID="seller-demo"
# Replicate — 배경 AI 미리보기(/api/transform) 등. https://replicate.com/account/api-tokens
# 빈 값으로 두지 마세요: REPLICATE_API_TOKEN="" 는 .env의 값까지 덮어씁니다. 미사용 시 줄 삭제.
REPLICATE_API_TOKEN="r8_your_token_here"
# (선택) 동일 토큰 — REPLICATE_API_TOKEN 이 비어 있을 때만 사용
# REPLICATE_TOKEN="r8_your_token_here"

# OAuth·절대 URL 기준 — 이 저장소는 **Supabase Auth + @supabase/ssr** 로 세션을 쿠키에 둡니다(NextAuth.js 패키지 없음).
# 그래도 `NEXTAUTH_URL` 은 `src/lib/authAppBaseUrl.ts` 등에서 **앱 origin 고정**에 쓰이므로, 주소창과 같게 두세요.
# 예: `npm run dev` 가 3000이면 `http://localhost:3000` — `127.0.0.1` 로 열면 그 origin과 혼용하지 마세요.
# NEXTAUTH_URL="http://localhost:3000"
# (선택) 쿠키 Secure 강제 — 기본은 development에서 false, production에서 true. 로컬에서 production 빌드 시 `0` 권장.
# SUPABASE_AUTH_COOKIE_SECURE=0

# Supabase (회원가입/이메일 인증)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# 공개 사이트 주소 — sitemap·OG 절대경로 등. 산 도메인이면 `https://내도메인.com` 처럼 실제 서비스 URL과 맞추세요.
# 비우면 Vercel `VERCEL_URL`(이 배포 주소)로 추론합니다. (과거에 쓰이던 고정 프로덕션 기본값은 제거됨)
# NEXT_PUBLIC_SITE_URL="https://example.com"
# (거의 불필요) Vercel 미리보기에서만 로그인·회원가입을 `NEXT_PUBLIC_SITE_URL` 호스트로 강제 이동 — 필요 시만 1
# NEXT_PUBLIC_FORCE_VERCEL_AUTH_TO_CANONICAL=1
# 로컬에서 구글 OAuth 콜백 origin 고정(프로덕션 도메인으로 안 튕기게). Supabase Redirect URLs에 동일 호스트의 /auth/callback 등록
# NEXT_PUBLIC_DEV_AUTH_REDIRECT_ORIGIN=http://localhost:3000
# 개발 시 탭당 1회만 Supabase 로컬 세션(쿠키) 비우기(예전 로그인 잔상). 새로고침마다 로그아웃되지는 않습니다.
# 로그인 유지만 테스트할 때는 끄세요.
# NEXT_PUBLIC_DEV_START_SIGNED_OUT=1
# (로컬 개발만) UI를 로그인된 것처럼 보이게 함. `npm run dev` + NODE_ENV=development 에서만 동작. 프로덕션 빌드에서는 무시됩니다.
# 실제 JWT가 아니므로 Supabase RLS·서버 API 인증이 필요한 기능은 실패할 수 있습니다.
# NEXT_PUBLIC_DEV_AUTH_SIMULATE_LOGIN="1"
# 서버 전용(비밀) — 로그인 아이디(이메일) 찾기 `/api/auth/find-email` 에만 사용. Git·프론트에 넣지 마세요.
# Dashboard → Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# --- Supabase 테이블 이름 (거의 항상 비워도 됨) ---
# 대시보드(Table Editor)에 보이는 public 테이블 이름이 아래 기본값과 다를 때만 설정합니다.
# 공백·괄호가 있어도 됩니다. 값에 공백이 있으면 따옴표로 감싸세요. SQL의 " 큰따옴표는 넣지 마세요.
# 기본값은 src/lib/supabaseTableNames.ts 를 보면 됩니다. snake_case로 바꿀 필요는 없습니다.
# NEXT_PUBLIC_SUPABASE_CART_TABLE="user_cart_items"
# NEXT_PUBLIC_SUPABASE_FAVORITES_TABLE="User Favorites (Wishlist/Likes) Table"
# NEXT_PUBLIC_SUPABASE_PROFILES_TABLE="User Profiles Table with RLS"
# NEXT_PUBLIC_SUPABASE_RECENT_VIEWS_TABLE="user_recent_views"
# NEXT_PUBLIC_SUPABASE_DEMO_PURCHASES_TABLE="user_demo_purchases"
# NEXT_PUBLIC_SUPABASE_CUSTOMIZE_DRAFTS_TABLE="user_customize_drafts"
# NEXT_PUBLIC_SUPABASE_DATA_BLOBS_TABLE="user_data_blobs"
# NEXT_PUBLIC_SUPABASE_SELLER_UPLOAD_DRAFTS_TABLE="seller_upload_drafts"
# NEXT_PUBLIC_SUPABASE_VIDEO_THUMBNAIL_SUMMARY_TABLE="Video Thumbnail Storage Summary"
# 가입 직후 바로 로그인되게 하려면: Dashboard → Authentication → Providers → Email → Confirm email 끄기
# 세션은 브라우저 쿠키 + src/middleware.ts 로 갱신합니다. 배포 후 한 번 로그아웃했다가 다시 로그인하면
# 예전(localStorage-only) 세션이 남아 있어도 새 방식으로 맞춰집니다.
# SMS 인증(Twilio Verify) — 회원가입/비밀번호 찾기/이메일 찾기용
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# (선택) SMS 인증 proof 서명용. 비우면 TIKTOK_SESSION_SECRET 또는 SUPABASE_SERVICE_ROLE_KEY를 사용.
# SMS_VERIFICATION_SECRET="long-random-secret"

# 홈 「실시간 인기순위」수동 TikTok URL (선택). 비우면 src/data/tiktokData.ts 의 파일 배열만 사용.
# 값은 JSON 배열 문자열: [{"id":1,"url":"https://www.tiktok.com/@handle/video/123..."}, ...]
# 상세는 src/data/tiktokData.ts 상단 주석 참고.
# NEXT_PUBLIC_TRENDING_TIKTOK_URLS='[{"id":1,"url":"https://www.tiktok.com/@example/video/7123456789012345678"}]'

# Google Cloud (console.cloud.google.com) — .env.local 에 실제 값만 넣고 커밋하지 마세요.
# Supabase Auth → Google: Client ID / Client Secret 은 대시보드에 입력. 로컬 참고용으로 아래에도 보관 가능.
# GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# YouTube Data API v3 등 (선택)
# GOOGLE_YOUTUBE_API_KEY="your-api-key"
# Gemini — reelsGenerate 등 (선택)
# GEMINI_API_KEY="your-gemini-key"

# TikTok OAuth / Trending 연동 (선택)
# TIKTOK_CLIENT_KEY="your_tiktok_client_key"
# TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"
# Production (replace with your public origin):
# TIKTOK_REDIRECT_URI="https://your-production-domain.example/api/auth/tiktok/callback"
# Local development can use a localhost or tunnel callback:
# TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"
# TIKTOK_SESSION_SECRET="long-random-secret-for-cookie-encryption"
# TIKTOK_OAUTH_SCOPE="user.info.basic,video.list"
# TIKTOK_DISCOVERY_ENDPOINT="https://open.tiktokapis.com/v2/"
# TIKTOK_VIDEO_FIELDS="id,title,video_description,duration,cover_image_url,share_url"

# KLING 연동 (선택)
# KLING_ACCESS_KEY="your_kling_access_key"
# KLING_SECRET_KEY="your_kling_secret_key"
# (구버전 단일 토큰 사용 시)
# KLING_API_TOKEN="legacy_kling_token"

# Google OAuth setup checklist:
# 1. Google Cloud Console > OAuth Client > Authorized redirect URIs:
#    https://YOUR_SUPABASE_PROJECT_REF.supabase.co/auth/v1/callback
#    Do not put your app callback (e.g. http://localhost:3000/auth/callback) here.
# 2. Supabase Dashboard > Authentication > URL Configuration:
#    Site URL (local — align with NEXTAUTH_URL):
#    http://localhost:3000
#    Additional Redirect URLs:
#    http://localhost:3000/auth/callback
#    http://127.0.0.1:3000/auth/callback
# 3. Supabase Dashboard > Authentication > Providers > Google:
#    Paste the Google OAuth Client ID and Client Secret.

# Polar payments (global card checkout)
# 1. Polar Dashboard에서 Credit Pack 상품을 생성합니다.
# 2. 각 상품 ID를 아래 PRODUCT_ID 환경변수에 넣습니다.
# 3. Polar Webhook endpoint:
#    https://your-production-domain.example/api/webhooks/polar
# 4. Webhook events:
#    order.paid, order.refunded
# 5. POLAR_SERVER는 실제 결제 전 sandbox, 운영 결제 시 production으로 둡니다.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN="your-polar-access-token"
POLAR_WEBHOOK_SECRET="your-polar-webhook-secret"
POLAR_CREDITS_STARTER_PRODUCT_ID="your-polar-product-id"
POLAR_CREDITS_CREATOR_PRODUCT_ID="your-polar-product-id"
POLAR_CREDITS_STUDIO_PRODUCT_ID="your-polar-product-id"

# Toss Payments (Korea pilot)
# Toss Developer Center > API 키에서 확인합니다.
# Client key는 브라우저에서 결제창을 열 때 쓰고, Secret key는 서버 결제 승인/취소에만 씁니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_your_toss_client_key"
TOSS_SECRET_KEY="test_sk_your_toss_secret_key"
# (로컬 개발) 토스 결제 없이 영상 상세「구매하기」→ 창작 스튜디오(/create)로 이동. 운영 배포에는 넣지 마세요.
# NEXT_PUBLIC_DEV_BYPASS_CHECKOUT_TO_STUDIO=1
# ARA 판매 수수료. 1000 = 10%, 2000 = 20%
PLATFORM_FEE_BPS="1000"
# 판매자 정산 가능 보류일. 환불 리스크를 줄이기 위해 초기값 7일 권장.
SELLER_SETTLEMENT_HOLD_DAYS="7"
