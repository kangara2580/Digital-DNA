generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 판매 중인 영상(조각). 가격·조회·판매 수는 배치·수락 API에서 갱신됩니다.
model Video {
  id               String    @id @default(cuid())
  title            String
  creator          String
  src              String
  poster           String
  orientation      String
  durationSec      Int?
  price            Int
  views            Int       @default(0)
  salesCount       Int       @default(0) @map("sales_count")
  /// open | limited | private | batch
  editionKind      String    @default("open") @map("edition_kind")
  editionCap       Int?      @map("edition_cap")
  sellerId         String    @map("seller_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  flashSaleUntil   DateTime? @map("flash_sale_until")
  /// 판매자 등록 시 설명(마켓 상세 연동용)
  description      String?
  /// 해시태그 — 쉼표 또는 공백 구분 저장(예: "#일상,#vlog")
  hashtags         String?
  /// AI 생성 여부(직접 촬영이면 false)
  isAiGenerated    Boolean   @default(false) @map("is_ai_generated")
  /// 판매자가 선택한 노출 카테고리(업로드/수정에서 필수 검증)
  category         String?
  sourcePageUrl    String?   @map("source_page_url")
  externalProvider String?   @map("external_provider")
  externalKey      String?   @map("external_key")
  processedVideoUrl    String? @map("processed_video_url")
  processedVideoStatus String  @default("pending") @map("processed_video_status")
  processedVideoError  String? @map("processed_video_error")
  status           String    @default("approved")
  moderationReason String?   @map("moderation_reason")
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")

  notifications  Notification[]
  generationJobs GenerationJob[]

  @@index([sellerId])
  @@index([createdAt])
  @@index([flashSaleUntil])
  @@index([status, createdAt])
  @@index([externalProvider, externalKey])
  @@map("videos")
}

/// Purchase records. Reviews, seller analytics, and settlement should depend on
/// this table instead of browser-only demo state.
model Purchase {
  id        String   @id @default(cuid())
  buyerId   String   @map("buyer_id")
  sellerId  String   @map("seller_id")
  videoId   String   @map("video_id")
  price     Int
  status    String   @default("paid")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([videoId])
  @@index([buyerId, videoId, status])
  @@map("purchases")
}

/// Payment records from external providers such as Polar.
/// This is the money ledger: one row per checkout/order lifecycle.
model Payment {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  userEmail          String?  @map("user_email")
  provider           String   @default("polar")
  providerPaymentKey String?  @unique @map("provider_payment_key")
  providerCheckoutId String?  @unique @map("provider_checkout_id")
  providerOrderId    String?  @unique @map("provider_order_id")
  orderName          String?  @map("order_name")
  productType        String   @map("product_type")
  productKey         String   @map("product_key")
  status             String   @default("pending")
  amountCents        Int      @default(0) @map("amount_cents")
  currency           String   @default("KRW")
  credits            Int      @default(0)
  targetId           String?  @map("target_id")
  metadataJson       Json?    @map("metadata_json")
  providerRawJson    Json?    @map("provider_raw_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  paidAt             DateTime? @map("paid_at")

  creditLedger CreditLedger[]
  events       PaymentEvent[]
  refunds      Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, productType, productKey])
  @@index([targetId])
  @@map("payments")
}

/// Raw payment lifecycle events. Keep original provider payloads for audit/debug.
model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String?  @map("payment_id")
  provider        String
  eventType       String   @map("event_type")
  providerEventId String?  @map("provider_event_id")
  orderId         String?  @map("order_id")
  paymentKey      String?  @map("payment_key")
  status          String?
  rawJson         Json?    @map("raw_json")
  createdAt       DateTime @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([provider, eventType, createdAt])
  @@index([orderId])
  @@index([paymentKey])
  @@map("payment_events")
}

/// Credit balance for fast reads. The authoritative history is CreditLedger.
model UserCreditBalance {
  userId    String   @id @map("user_id")
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_credit_balances")
}

/// Credit ledger. Every credit increase/decrease must leave one immutable row.
model CreditLedger {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  paymentId   String?  @map("payment_id")
  type        String
  amount      Int
  balanceAfter Int     @map("balance_after")
  reason      String
  metadataJson Json?   @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([paymentId, type])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("credit_ledger")
}

/// What a user is allowed to access after a purchase.
model UserEntitlement {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  purchaseId String?  @map("purchase_id")
  status     String   @default("active")
  startsAt   DateTime @default(now()) @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, sourceType, sourceId])
  @@index([userId, status])
  @@index([purchaseId])
  @@map("user_entitlements")
}

/// User refund request before/after actual Toss cancel call.
model RefundRequest {
  id           String   @id @default(cuid())
  requesterId String   @map("requester_id")
  paymentId    String?  @map("payment_id")
  purchaseId   String?  @map("purchase_id")
  reason       String
  detail       String?
  status       String   @default("requested")
  adminMemo    String?  @map("admin_memo")
  reviewedBy   String?  @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([paymentId])
  @@index([purchaseId])
  @@map("refund_requests")
}

/// Actual refund/cancel result from provider.
model Refund {
  id                 String   @id @default(cuid())
  paymentId          String   @map("payment_id")
  refundRequestId    String?  @map("refund_request_id")
  provider           String   @default("toss")
  providerRefundKey  String?  @map("provider_refund_key")
  amountCents        Int      @map("amount_cents")
  currency           String   @default("KRW")
  reason             String
  status             String   @default("succeeded")
  providerRawJson    Json?    @map("provider_raw_json")
  createdAt          DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([refundRequestId])
  @@map("refunds")
}

/// Seller revenue per paid purchase. This is the settlement source of truth.
model SellerEarning {
  id              String   @id @default(cuid())
  sellerId        String   @map("seller_id")
  buyerId         String   @map("buyer_id")
  purchaseId      String   @unique @map("purchase_id")
  paymentId       String?  @map("payment_id")
  videoId         String   @map("video_id")
  grossAmount     Int      @map("gross_amount")
  platformFee     Int      @map("platform_fee")
  netAmount       Int      @map("net_amount")
  feeRateBps      Int      @default(1000) @map("fee_rate_bps")
  status          String   @default("pending")
  availableAt     DateTime @map("available_at")
  settlementId    String?  @map("settlement_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([sellerId, status, availableAt])
  @@index([paymentId])
  @@index([videoId])
  @@map("seller_earnings")
}

/// ARA commission per purchase/refund.
model PlatformFee {
  id          String   @id @default(cuid())
  paymentId   String?  @map("payment_id")
  purchaseId  String?  @map("purchase_id")
  sellerId    String?  @map("seller_id")
  amount      Int
  currency    String   @default("KRW")
  feeRateBps  Int      @map("fee_rate_bps")
  status      String   @default("earned")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([purchaseId])
  @@index([sellerId, createdAt])
  @@map("platform_fees")
}

/// Seller asks the admin to settle available earnings.
model SellerSettlementRequest {
  id           String   @id @default(cuid())
  sellerId     String   @map("seller_id")
  amount       Int
  currency     String   @default("KRW")
  bankName     String?  @map("bank_name")
  accountNo    String?  @map("account_no")
  accountHolder String? @map("account_holder")
  status       String   @default("requested")
  adminMemo    String?  @map("admin_memo")
  reviewedBy   String?  @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("seller_settlement_requests")
}

/// Admin settlement batch. MVP can be manual bank transfer, recorded here.
model SellerSettlement {
  id                  String   @id @default(cuid())
  sellerId            String   @map("seller_id")
  settlementRequestId String?  @map("settlement_request_id")
  amount              Int
  currency            String   @default("KRW")
  status              String   @default("approved")
  method              String   @default("manual")
  adminMemo           String?  @map("admin_memo")
  processedBy         String?  @map("processed_by")
  processedAt         DateTime? @map("processed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([sellerId, status])
  @@index([settlementRequestId])
  @@map("seller_settlements")
}

/// Seller plan/subscription state. Polar subscriptions can be connected here next.
model SellerSubscription {
  id                     String   @id @default(cuid())
  sellerId               String   @map("seller_id")
  provider               String   @default("polar")
  providerSubscriptionId String?  @unique @map("provider_subscription_id")
  planKey                String   @map("plan_key")
  status                 String   @default("active")
  currentPeriodEnd       DateTime? @map("current_period_end")
  metadataJson           Json?    @map("metadata_json")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([sellerId, status])
  @@map("seller_subscriptions")
}

/// Persistent AI generation jobs. This replaces in-memory Map state for
/// production flows where serverless instances can restart at any time.
model GenerationJob {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  sourceVideoId String?  @map("source_video_id")
  status        String   @default("queued")
  stage         String   @default("queued")
  progress      Int      @default(0)
  inputJson     Json?    @map("input_json")
  providerJson  Json?    @map("provider_json")
  outputUrl     String?  @map("output_url")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sourceVideo Video? @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([sourceVideoId])
  @@map("generation_jobs")
}

/// Every important admin mutation should write an audit row.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model AdminNote {
  id         String   @id @default(cuid())
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  body       String
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([createdBy, createdAt])
  @@map("admin_notes")
}

model ContentChangeLog {
  id         String   @id @default(cuid())
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  actorId    String   @map("actor_id")
  actorType  String   @map("actor_type")
  changeType String   @map("change_type")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("content_change_logs")
}

/// Reports for moderation workflows.
model Report {
  id              String   @id @default(cuid())
  reporterId      String?  @map("reporter_id")
  targetType      String   @map("target_type")
  targetId        String   @map("target_id")
  reason          String
  status          String   @default("open")
  assignedAdminId String?  @map("assigned_admin_id")
  adminNote       String?  @map("admin_note")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// 판매자 알림(가격 제안 등)
model Notification {
  id        String   @id @default(cuid())
  sellerId  String   @map("seller_id")
  type      String
  title     String
  body      String
  videoId   String   @map("video_id")
  oldPrice  Int      @map("old_price")
  newPrice  Int      @map("new_price")
  read      Boolean  @default(false)
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@index([videoId, type, status])
  @@map("notifications")
}

/// 영상 구매평 — 구매한 사용자만 작성 가능
model VideoReview {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  userId    String   @map("user_id")
  nickname  String
  rating    Int /// 1–5
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([videoId, userId])
  @@index([videoId, createdAt])
  @@map("video_reviews")
}

/// 닉네임 중복 방지용 예약 레코드 (대소문자 구분 없이 unique)
model NicknameReservation {
  id              String   @id @default(cuid())
  nickname        String   @unique
  displayNickname String   @map("display_nickname")
  reservedByEmail String?  @map("reserved_by_email")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("nickname_reservations")
}

model TikTokAuthSession {
  id           String   @id @default(cuid())
  sessionId    String   @unique @map("session_id")
  accessToken  String?  @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresAt    Int      @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("tiktok_auth_sessions")
}
